AP_SSID=rust-was-here
AP_PASS=change-me-for-your-own

# Multiple Wi-Fi networks for cycling (client mode)
ST_SSID_1=HomeWifi
ST_PASS_1=homepassword123

ST_SSID_2=WorkWifi
ST_PASS_2=workpassword456

ST_SSID_3=GuestWifi
ST_PASS_3=guestpassword789

# Legacy support (backwards compatibility)
ST_SSID=WIFI-SSID
ST_PASS=SUPER_SECRET_PASSWORD

# Optional: Static DHCP reservations (MAC → IP)
# Provide MAC without separators (colons/dashes), prefixed with DHCP_
# Example: reserve 192.168.4.150 for AA:BB:CC:DD:EE:FF
# DHCP_AABBCCDDEEFF=192.168.4.150
# Use IP addresses above 192.168.4.100 for static reservations.
